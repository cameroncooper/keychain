#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
# Let Qt discover qmake6; an explicit QMAKE from the caller is respected.
cargo test --release --locked --manifest-path "$root/Cargo.toml" --lib gui:: -j 1
cargo test --release --locked --manifest-path "$root/desktop/Cargo.toml" --target-dir "$root/target" -j 1 --test gui-smoke
