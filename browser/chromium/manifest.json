{
  "manifest_version": 3,
  "name": "Keychain",
  "version": "0.1.1",
  "description": "Fill passwords and verification codes and use passkeys through the local Keychain biometric broker.",
  "minimum_chrome_version": "115",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "webAuthenticationProxy",
    "activeTab",
    "webNavigation"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Keychain",
    "default_popup": "toolbar.html"
  },
  "host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "menu-style.js",
        "forms/classifier.js",
        "forms/dom.js",
        "forms/menu.js",
        "forms.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
