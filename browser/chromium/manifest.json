{
  "manifest_version": 3,
  "name": "Keychain Passkeys",
  "version": "0.1.0",
  "description": "Use passkeys synced from Apple Passwords through the local keychain utility.",
  "minimum_chrome_version": "115",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "webAuthenticationProxy"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Keychain Passkeys"
  }
}
