{
  "manifest_version": 2,
  "name": "Keychain",
  "version": "0.1.2",
  "description": "Fill passwords and verification codes and use passkeys through the local Keychain biometric broker.",
  "browser_specific_settings": {
    "gecko": {
      "id": "keychain@cameroncooper",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "webNavigation",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "sender.js",
      "background.js",
      "forms-background.js",
      "core.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "webauthn.js",
        "content.js",
        "menu-style.js",
        "forms/classifier.js",
        "forms/dom.js",
        "forms/menu.js",
        "forms.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "Keychain",
    "default_popup": "toolbar.html"
  }
}
