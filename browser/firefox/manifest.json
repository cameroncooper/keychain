{
  "manifest_version": 2,
  "name": "Keychain Passkeys",
  "version": "0.1.0",
  "description": "Use Keychain passkeys through the local biometric broker.",
  "browser_specific_settings": {
    "gecko": {
      "id": "keychain@cameroncooper",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "webNavigation",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js",
      "core.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "webauthn.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "Keychain Passkeys"
  }
}
